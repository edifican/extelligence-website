---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  hideHeaderUntilScroll?: boolean;
}

const {
  title,
  description = 'Extelligence — intelligent solutions for a smarter tomorrow.',
  ogImage = '/og-default.png',
  noindex = false,
  hideHeaderUntilScroll = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const pageTitle = title.includes('Building Extelligence') ? title : `${title} | Building Extelligence`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Per-page head additions (scripts, preloads, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-black text-white flex flex-col antialiased">
    <Header hideUntilScroll={hideHeaderUntilScroll} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
