---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Building Extelligence"
  description="AI-native building energy simulation."
  hideHeaderUntilScroll={true}
>
  <script
    slot="head"
    src="https://js-na3.hsforms.net/forms/embed/343346397.js"
    defer
    is:inline
  ></script>

  <!-- ─── 1. HERO ─────────────────────────────────────────────────────────── -->
  <section class="relative min-h-screen bg-black flex flex-col items-center justify-center text-center px-6 py-32">
    <img
      src="/be_logo_dark_nt.svg"
      alt="Building Extelligence"
      class="w-80 sm:w-[420px] md:w-[560px] mb-10 select-none"
    />
    <p class="text-white/70 text-lg sm:text-xl md:text-2xl font-light tracking-wide mb-10 max-w-xl">
      AI-native building energy simulation.
    </p>
    <a
      href="#early-access"
      class="inline-block px-8 py-3.5 rounded-lg bg-cyan-400 text-black font-semibold text-base hover:bg-cyan-300 transition-colors"
    >
      Get Early Access
    </a>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/20 text-xs tracking-widest uppercase">
      <span>Scroll</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- ─── 2. THE PROBLEM ───────────────────────────────────────────────────── -->
  <section class="bg-zinc-950 py-24 px-6">
    <div class="mx-auto max-w-3xl">
      <p class="text-cyan-400 text-sm font-semibold uppercase tracking-widest mb-6">The Problem</p>
      <h2 class="text-white text-3xl sm:text-4xl font-bold leading-tight mb-8">
        Building energy simulation software has barely changed in twenty years.
      </h2>
      <p class="text-white/60 text-lg leading-relaxed">
        Models are built by hand, rebuilt from scratch on every project, and updates to a single project can consume your whole week.
      </p>
    </div>
  </section>

  <!-- ─── 3. WHAT WE'RE BUILDING ───────────────────────────────────────────── -->
  <section class="bg-black py-24 px-6 border-t border-white/5">
    <div class="mx-auto max-w-3xl">
      <p class="text-cyan-400 text-sm font-semibold uppercase tracking-widest mb-6">What We're Building</p>
      <h2 class="text-white text-3xl sm:text-4xl font-bold leading-tight mb-10">
        Your simulation workflow, reimagined with AI to help.
      </h2>
      <p class="text-white/60 text-lg leading-relaxed mb-12">
        Building Extelligence reimagines the simulation workflow around AI, from the first model to the final compliance report.
      </p>

      <ul class="space-y-8">
        {[
          {
            heading: 'Conversational model editing',
            body: 'Say or type edits like "increase glazing to 60% in south-facing zones" then confirm to see them applied instantly.',
          },
          {
            heading: 'Works across your back catalog',
            body: '"Update constructions to match our last LEED project and show me the new EUI." Your entire project history, instantly queryable.',
          },
          {
            heading: 'Collaborative by design',
            body: 'Models simulated and versioned in the cloud, editable by your whole team, from anywhere.',
          },
        ].map(({ heading, body }) => (
          <li class="flex gap-5">
            <span class="mt-1 flex-shrink-0 w-2 h-2 rounded-full bg-cyan-400 ring-4 ring-cyan-400/20 translate-y-1.5"></span>
            <div>
              <p class="text-white font-semibold text-lg mb-1">{heading}</p>
              <p class="text-white/55 leading-relaxed">{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── 4. EARLY ACCESS FORM ─────────────────────────────────────────────── -->
  <section id="early-access" class="bg-white py-24 px-6">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-cyan-600 text-sm font-semibold uppercase tracking-widest mb-4">Early Access</p>

      <div
        class="hs-form-frame"
        data-region="na3"
        data-form-id="75845e03-7ee8-41da-957e-defd5820e898"
        data-portal-id="343346397"
      ></div>
    </div>
  </section>
</BaseLayout>
