---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Extelligence. We'd love to hear about your project and explore how we can help."
>
  <script
    slot="head"
    src="https://js-na3.hsforms.net/forms/embed/343346397.js"
    defer
    is:inline
  ></script>
  <section class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-20">
    <div class="mx-auto max-w-6xl px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <!-- Left: copy -->
      <div>
        <span class="inline-block mb-4 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium">
          Let's talk
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Start the conversation
        </h1>
        <p class="text-gray-600 text-lg leading-relaxed mb-8">
          Whether you have a specific challenge in mind or you're just curious about what Extelligence can do, we'd love to hear from you. Fill in the form and we'll be in touch within one business day.
        </p>

        <ul class="space-y-4 text-gray-700">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex-shrink-0 w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Response within one business day</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex-shrink-0 w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>No obligation, no sales pressure</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex-shrink-0 w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Confidentiality respected at all times</span>
          </li>
        </ul>
      </div>

      <!-- Right: HubSpot form -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <div
          class="hs-form-frame"
          data-region="na3"
          data-form-id="75845e03-7ee8-41da-957e-defd5820e898"
          data-portal-id="343346397"
        ></div>
      </div>
    </div>
  </section>
</BaseLayout>
