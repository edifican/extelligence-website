---
interface Props {
  hideUntilScroll?: boolean;
}
const { hideUntilScroll = false } = Astro.props;
---

<header
  id="site-header"
  class:list={[
    'sticky top-0 z-50 bg-black/80 backdrop-blur px-6 py-4 transition-opacity duration-500',
    hideUntilScroll ? 'opacity-0 pointer-events-none' : 'opacity-100',
  ]}
>
  <a href="/" aria-label="Building Extelligence home">
    <img src="/be_logo_dark_nt.svg" alt="Building Extelligence" class="h-10 w-auto" />
  </a>
</header>

{hideUntilScroll && (
  <script>
    const header = document.getElementById('site-header');
    const heroHeight = window.innerHeight * 0.5;

    function update() {
      if (window.scrollY > heroHeight) {
        header?.classList.remove('opacity-0', 'pointer-events-none');
        header?.classList.add('opacity-100');
      } else {
        header?.classList.add('opacity-0', 'pointer-events-none');
        header?.classList.remove('opacity-100');
      }
    }

    window.addEventListener('scroll', update, { passive: true });
  </script>
)}
